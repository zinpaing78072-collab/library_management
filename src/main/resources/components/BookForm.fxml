<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="673.0" prefWidth="762.0"
            xmlns="http://javafx.com/javafx/8.0.171"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.controller.BookFormController">
   <children>
      <Label layoutX="33.0" layoutY="61.0" text="Title" />
      <Label layoutX="33.0" layoutY="109.0" text="ISBN" />
      <Label layoutX="33.0" layoutY="157.0" text="Author" />
      <Label layoutX="33.0" layoutY="198.0" text="Published Year" />
      <Label layoutX="33.0" layoutY="238.0" text="Category" />
      <Label layoutX="33.0" layoutY="298.0" text="Description" />
      <Label layoutX="33.0" layoutY="371.0" text="Copies" />
      <Label layoutX="38.0" layoutY="426.0" text="Publisher" />
      <TextField fx:id="txtTitle" layoutX="172.0" layoutY="56.0" />
      <TextField fx:id="txtISBN" layoutX="172.0" layoutY="104.0" />
      <TextField fx:id="txtPYear" layoutX="172.0" layoutY="192.0" />
      <TextField fx:id="txtCopies" layoutX="172.0" layoutY="364.0" />
      <TextArea fx:id="txtDescription" layoutX="169.0" layoutY="276.0"
                prefHeight="66.0" prefWidth="195.0" />
      <ComboBox fx:id="cbAuthor" layoutX="172.0" layoutY="152.0" prefWidth="150.0" />
      <ComboBox fx:id="cbCategory" layoutX="172.0" layoutY="232.0" prefWidth="150.0" />
      <ComboBox fx:id="cbPublisher" layoutX="172.0" layoutY="418.0" prefWidth="150.0" />
      <ImageView fx:id="imgBook" fitHeight="190.0" fitWidth="200.0"
                 layoutX="494.0" layoutY="57.0" pickOnBounds="true" preserveRatio="true" />
      <Button fx:id="btnUploadBook" layoutX="537.0" layoutY="294.0"
              mnemonicParsing="false" text="Upload Photo" />
      <Button fx:id="btnSaveBook" layoutX="77.0" layoutY="536.0"
              mnemonicParsing="false" text="Save" />
      <Button fx:id="btnClear" layoutX="215.0" layoutY="536.0"
              mnemonicParsing="false" text="Clear" />
   </children>
</AnchorPane>
