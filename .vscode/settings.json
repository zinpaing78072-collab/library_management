{
    "java.configuration.updateBuildConfiguration": "automatic",
    "java.debug.settings": {
        "vmArgs": "--module-path ${env:HOME}/.m2/repository/org/openjfx/javafx-base/21.0.6/javafx-base-21.0.6-mac.jar:${env:HOME}/.m2/repository/org/openjfx/javafx-graphics/21.0.6/javafx-graphics-21.0.6-mac.jar:${env:HOME}/.m2/repository/org/openjfx/javafx-controls/21.0.6/javafx-controls-21.0.6-mac.jar:${env:HOME}/.m2/repository/org/openjfx/javafx-fxml/21.0.6/javafx-fxml-21.0.6-mac.jar --add-modules javafx.controls,javafx.fxml",
        "console": "integratedTerminal"
    },
    "java.jdt.ls.vmargs": "-Xmx512m -XX:+UseStringDeduplication -XX:+UseG1GC",
    "java.import.exclusions": [
        "**/node_modules/**",
        "**/.metadata/**",
        "**/archetype-resources/**",
        "**/META-INF/maven/**",
        "**/target/**",
        "**/build/**",
        "**/.gradle/**"
    ],
    "files.watcherExclude": {
        "**/target/**": true,
        "**/build/**": true,
        "**/.gradle/**": true,
        "**/dist/**": true,
        "**/node_modules/**": true,
        "**/.git/**": true
    },
    "search.exclude": {
        "**/target": true,
        "**/build": true,
        "**/.gradle": true,
        "**/dist": true,
        "**/node_modules": true,
        "**/.git": true
    }
}